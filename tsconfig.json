{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "assets",
    "rootDir": "src",
    "removeComments": false,
    "noEmitOnError": true
  },
  "include": ["src/main.ts"]
}
